mission11.dart
coding:
void main() {
  String snackName = 'Samosa';
  int pricePerSnack = 15; // in ₹
  int quantity = 10;
  int friends = 4;

  int totalPrice = pricePerSnack * quantity;
  int eachGets = quantity ~/ friends; // integer division
  int leftoverSnacks = quantity % friends; // remainder

  print('Snack          : $snackName');
  print('Quantity       : $quantity @ ₹$pricePerSnack each');
  print('Total Price    : ₹$totalPrice');
  print('Shared Among   : $friends friends ($eachGets each)');
  print('Leftover count : $leftoverSnacks');
}
 output:
Snack          : Samosa
Quantity       : 10 @ ₹15 each
Total Price    : ₹150
Shared Among   : 4 friends (2 each)
Leftover count : 2
