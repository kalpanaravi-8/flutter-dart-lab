mission08.dart
coding:
void main() {
  String studentName = 'Ananya Sharma';
  String? nickname;
  int? bonusMarks;
  print('--- Before Assigning Values ---');
  print('Student     : $studentName');
  print('Nickname    : ${nickname ?? "None"}');
  print('Bonus Marks : ${bonusMarks ?? 0}');
  nickname = 'Anu';
  bonusMarks = 5;
  print('\n--- After Assigning Values ---');
  print('Student     : $studentName');
  print('Nickname    : ${nickname ?? "None"}');
  print('Bonus Marks : ${bonusMarks ?? 0}');
}

output:
--- Before Assigning Values ---
Student     : Ananya Sharma
Nickname    : None
Bonus Marks : 0

--- After Assigning Values ---
Student     : Ananya Sharma
Nickname    : Anu
Bonus Marks : 5

